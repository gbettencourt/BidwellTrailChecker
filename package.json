{
	"name": "trailchecker",
	"version": "1.0.0",
	"type": "module",
	"description": "",
	"main": "index.js",
	"scripts": {
		"start": "node dist/index.js",
		"clean": "rm -rf dist",
		"build": "npm run clean && tsc && rsync -a client dist --exclude node_modules",
		"check": "node dist/checker.js",
		"check-types": "tsc --noEmit",
		"test": "vitest run && npm --prefix client test",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"keywords": [],
	"author": "Gary Bettencourt",
	"license": "MIT",
	"dependencies": {
		"dotenv": "^17.2.3",
		"express": "^5.3.0",
		"express-validator": "^7.3.2",
		"express-winston": "^4.2.0",
		"jsonwebtoken": "^9.0.3",
		"lowdb": "^7.0.1",
		"node-html-parser": "^9.0.7",
		"node-schedule": "^2.1.2",
		"nodemailer": "^10.6.0",
		"twilio": "^5.10.2",
		"winston": "^3.19.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.6.6",
		"@types/node-schedule": "^2.1.8",
		"@typescript/native": "npm:typescript@^7.0.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.73.0",
		"vitest": "^5.1.0"
	},
	"prettier": {
		"printWidth": 140,
		"tabWidth": 4,
		"useTabs": true,
		"semi": true,
		"singleQuote": true,
		"trailingComma": "none",
		"bracketSpacing": true,
		"bracketSameLine": true,
		"arrowParens": "always"
	},
	"allowScripts": {
		"fsevents@2.3.3": true
	}
}
