{
	"compilerOptions": {
		"target": "esnext",
		"lib": ["esnext"],
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"outDir": "dist"
	},
	"include": ["*.ts", "private/*.ts"],
	"exclude": ["client"]
}
